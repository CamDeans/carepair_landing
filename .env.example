# Canonical URL for Open Graph, sitemap, and robots (no trailing slash)
# Example: https://www.carepair.ca
NEXT_PUBLIC_SITE_URL=

# App store listing URLs — when both are set, the home page shows download buttons.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Public contact email — used for footer mailto, mail-app draft fallback, and 503 fallback from the API.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Secure contact form (Resend) — server-only except NEXT_PUBLIC_CONTACT_EMAIL above ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives inquiry emails (can match NEXT_PUBLIC_CONTACT_EMAIL).
CONTACT_INBOX_EMAIL=
# Verified sender in Resend, e.g. "CarePair <inquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=
