# Canonical URL for Open Graph, sitemap, and robots (no trailing slash)
# Example: https://www.carepair.ca
NEXT_PUBLIC_SITE_URL=

# App store listing URLs — when both are set, the home page shows download buttons.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Shown for support, partnerships, and early access inquiries
NEXT_PUBLIC_CONTACT_EMAIL=
