# Canonical URL for Open Graph, sitemap, and robots (no trailing slash)
# Example: https://www.carepair.ca
NEXT_PUBLIC_SITE_URL=

# App store listing URLs — when both are set, the home page shows download buttons.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Required for the /contact form and mailto drafts: a real inbox you monitor.
# Used for support, partnerships, early access, and press routing (topic picker on the site).
NEXT_PUBLIC_CONTACT_EMAIL=
